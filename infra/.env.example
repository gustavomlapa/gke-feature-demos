# ==============================================================================
# Configurações do Google Cloud para as Demos de GKE
# Copie este arquivo para .env na raiz do projeto ou na pasta infra/
# Exemplo: cp infra/.env.example .env
# ==============================================================================

# ID do seu projeto no Google Cloud (Obrigatório)
PROJECT_ID="your-gcp-project-id"

# Região do GCP para o Cluster GKE e Artifact Registry (ex: us-central1, us-east1, southamerica-east1)
REGION="us-central1"

# Nome do cluster GKE
CLUSTER_NAME="gke-demos-cluster"

# Nome do repositório no Google Artifact Registry para armazenar as imagens
ARTIFACT_REGISTRY_REPO="gke-demos"

# Canal de lançamento do GKE (Autopilot suporta: rapid, regular, stable)
RELEASE_CHANNEL="stable"
